...@infra.d2

style: {
  fill: transparent
}

classes: {
  container: {
    style: {
      fill: "#f4f1ea"
      stroke: "#b8b2a6"
      font-color: "#14161a"
      font-size: 20
      border-radius: 10
      stroke-width: 2
    }
  }
  node: {
    style: {
      fill: "#fbf9f4"
      stroke: "#2c2f35"
      font-color: "#14161a"
      font-size: 18
      border-radius: 8
      stroke-width: 2
    }
  }
  accent: {
    style: {
      fill: "#f9ece7"
      stroke: "#c94f2c"
      font-color: "#a63a1c"
      font-size: 18
      border-radius: 8
      stroke-width: 2
      bold: true
    }
  }
  edge: {
    style: {
      stroke: "#5b5e66"
      font-color: "#5b5e66"
      font-size: 16
      stroke-width: 2
    }
  }
}
