...@infra.d2

style: {
  fill: transparent
}

classes: {
  container: {
    style: {
      fill: "#111827"
      stroke: "#364154"
      font-color: "#d9d7ce"
      font-size: 20
      border-radius: 10
      stroke-width: 2
    }
  }
  node: {
    style: {
      fill: "#0b101b"
      stroke: "#6b768a"
      font-color: "#d9d7ce"
      font-size: 18
      border-radius: 8
      stroke-width: 2
    }
  }
  accent: {
    style: {
      fill: "#261c14"
      stroke: "#ffa759"
      font-color: "#ffcc66"
      font-size: 18
      border-radius: 8
      stroke-width: 2
      bold: true
    }
  }
  edge: {
    style: {
      stroke: "#8a94a6"
      font-color: "#8a94a6"
      font-size: 16
      stroke-width: 2
    }
  }
}
