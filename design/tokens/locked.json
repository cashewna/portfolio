    "baseUnit": 8,
    "density": "spacious",
    "radius": 14,
    "chroma": 0.25,
    "accentHue": 15,
    "borderWeight": "hairline",
    "motionMs": 160,
    "scheme": "light"
  },
  "$schema": "https://tr.designtokens.org/format/",
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#F4F1EA"
    },
    "surface": {
      "$type": "color",
      "$value": "#FBF9F4"
    },
    "text": {
      "$type": "color",
      "$value": "#14161A"
    },
    "text-muted": {
      "$type": "color",
      "$value": "#52555D"
    },
    "border": {
      "$type": "color",
      "$value": "#DCD8CE"
    },
    "accent": {
      "$type": "color",
      "$value": "#A63A1C"
    },
    "on-accent": {
      "$type": "color",
      "$value": "#FBF9F4"
    },
    "danger": {
      "$type": "color",
      "$value": "#8F2222"
