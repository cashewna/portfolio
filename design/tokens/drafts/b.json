{
  "draft": "B",
  "name": "Systems Monograph",
  "adjectives": ["technical", "dark-first", "precise", "compact", "high-contrast"],
  "antiAdjectives": ["playful", "warm-paper", "decorative"],
  "axes": {
    "displayType": "grotesque",
    "bodyType": "grotesque",
    "baseUnit": 4,
    "density": "compact",
    "radius": 4,
    "chroma": 0.35,
    "accentHue": 172,
    "borderWeight": "hairline",
    "motionMs": 100,
    "scheme": "dark"
  },
  "costs": [
    "dark-first surface feels more like an engineering tool/console than a personal letter",
    "compact density packs more above the fold but leaves less breathing room around prose",
    "sans display loses the editorial warmth of serif headlines"
  ],
  "selfCritique": "Immediately signals software and systems engineering credibility: tight metadata rails, crisp 4px geometry, and high-contrast slate surfaces suited for architecture diagrams and terminal previews.",
  "tokens": {
    "color": {
      "bg": { "$type": "color", "$value": "#0B101B" },
      "surface": { "$type": "color", "$value": "#111827" },
      "text": { "$type": "color", "$value": "#D9D7CE" },
      "text-muted": { "$type": "color", "$value": "#8A94A6" },
      "border": { "$type": "color", "$value": "#1E293B" },
      "accent": { "$type": "color", "$value": "#FFA759" },
      "on-accent": { "$type": "color", "$value": "#070B13" },
      "danger": { "$type": "color", "$value": "#F28779" },
      "success": { "$type": "color", "$value": "#BAE67E" },
      "focus": { "$type": "color", "$value": "#FFCC66" }
    },
    "font": {
      "family": {
        "display": { "$type": "fontFamily", "$value": "system-ui, -apple-system, Segoe UI, sans-serif" },
        "body": { "$type": "fontFamily", "$value": "system-ui, -apple-system, Segoe UI, sans-serif" },
        "mono": { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, Menlo, monospace" }
      },
      "size": {
        "sm": { "$type": "dimension", "$value": "13px" },
        "md": { "$type": "dimension", "$value": "15px" },
        "lg": { "$type": "dimension", "$value": "18px" },
        "xl": { "$type": "dimension", "$value": "24px" },
        "display": { "$type": "dimension", "$value": "44px" }
      }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "36px" }
    },
    "radius": {
      "sm": { "$type": "borderRadius", "$value": "2px" },
      "md": { "$type": "borderRadius", "$value": "4px" },
      "lg": { "$type": "borderRadius", "$value": "6px" }
    },
    "border": {
      "hairline": { "$type": "dimension", "$value": "1px" },
      "thick": { "$type": "dimension", "$value": "2px" }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": "60ms" },
      "base": { "$type": "duration", "$value": "100ms" },
      "slow": { "$type": "duration", "$value": "180ms" },
      "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    },
    "density": {
      "row": { "$type": "dimension", "$value": "44px" }
    }
  }
}
